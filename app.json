{
  "expo": {
    "name": "Aaron",
    "slug": "hostel-chores-frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app_icon_a_clean.png",
    "scheme": "hostelchoresfrontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/app_icon_a_clean.png"
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/app_icon_a_clean.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.coaman.hostelchoresfrontend"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ba542f3b-d39c-410f-83a5-10a1d36b925a"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ba542f3b-d39c-410f-83a5-10a1d36b925a"
    }
  }
}
